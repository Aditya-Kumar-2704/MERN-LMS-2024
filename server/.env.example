PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/your-db
CLIENT_URL=http://localhost:5173
SECRET_KEY=use-a-long-random-string-in-production

# First account registered with this email becomes the only bootstrap admin (when no admin exists yet).
ADMIN_EMAIL=owner@yourdomain.com

# PayPal, Cloudinary, etc. — set as you already use in the project.
