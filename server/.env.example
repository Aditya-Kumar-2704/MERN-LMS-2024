PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/your-db
CLIENT_URL=http://localhost:5173
SECRET_KEY=use-a-long-random-string-in-production

# First account registered with this email becomes the only bootstrap admin (when no admin exists yet).
ADMIN_EMAIL=owner@yourdomain.com

# Optional: folder for direct + server uploads (default vikash-courses)
# CLOUDINARY_UPLOAD_FOLDER=vikash-courses
# CLOUDINARY_PROFILE_FOLDER=vikash-profiles

# PayPal
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# PAYPAL_MODE=sandbox

# Cloudinary keys (CLOUD_NAME, API_KEY, API_SECRET), etc.
